diff --git a/lmcache/v1/distributed/pin_groups.py b/lmcache/v1/distributed/pin_groups.py
new file mode 100644
index 00000000..d84f2812
--- /dev/null
+++ b/lmcache/v1/distributed/pin_groups.py
@@ -0,0 +1,444 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Prefix-derived pin groups for L1 objects.
+
+A pin group keeps one conversation prefix resident so it survives the idle gap
+between two turns. Group identity comes from the prefix itself rather than from
+the client: the id is ``<model_version>:<tail chunk hash>``, where the tail is
+the last complete chunk of the request's token sequence. Two properties follow.
+No caller has to supply a trajectory id, which the engine never receives in
+auto trajectory mode. And because a prefix only grows across turns, the previous
+turn's group is released by matching its tail against the current prefix's
+chunk hashes.
+
+Pins themselves are reference counted and never expire, so this registry adds
+the lifecycle that makes them safe to leave running unattended: an idle TTL, a
+byte budget that releases the oldest groups first, and release when a newer
+model version appears.
+
+Identity invariant: a pin group must never take part in cache identity. Callers
+name the tag ``lmcache.pin_group``, deliberately outside the ``lmcache.tag.``
+prefix that :meth:`IPCCacheServerKey.derive_tags` reads.
+"""
+
+# Standard
+from dataclasses import dataclass, field
+import threading
+import time
+from typing import TYPE_CHECKING, Iterable, Sequence
+
+# First Party
+from lmcache.logging import init_logger
+from lmcache.v1.distributed.api import ObjectKey
+
+if TYPE_CHECKING:
+    from lmcache.v1.distributed.l1_manager import L1Manager
+
+logger = init_logger(__name__)
+
+# Policies accepted by ``--l1-pin-policy``.
+PIN_POLICIES = ("off", "all", "tagged")
+
+# Request-config key carrying an explicit pin group. It must stay outside the
+# ``lmcache.tag.`` namespace, which participates in cache identity.
+PIN_GROUP_CONFIG_KEY = "lmcache.pin_group"
+
+# Request-config key carrying the model version, which does participate in
+# cache identity. Read here only to name the group and to fence older versions.
+MODEL_VERSION_CONFIG_KEY = "lmcache.tag.model_version"
+
+
+@dataclass(frozen=True)
+class PinTarget:
+    """One prefix to hold resident, already resolved to object keys.
+
+    Attributes:
+        group: Group id, ``<version>:<tail hex>``.
+        version: Model version the objects were stored under, empty when the
+            deployment does not tag versions.
+        tail: Chunk hash of the prefix's last complete chunk.
+        keys: Every object key of the prefix, resident or just written.
+        prefix_hashes: Chunk hashes of the whole prefix, used to recognise the
+            groups this one supersedes.
+    """
+
+    group: str
+    version: str
+    tail: bytes
+    keys: tuple[ObjectKey, ...]
+    prefix_hashes: frozenset[bytes]
+
+
+@dataclass
+class PinGroup:
+    """Bookkeeping for one live pin group."""
+
+    group: str
+    version: str
+    tail: bytes
+    keys: set[ObjectKey] = field(default_factory=set)
+    bytes: int = 0
+    created_at: float = 0.0
+    last_touch: float = 0.0
+
+
+@dataclass(frozen=True)
+class PinResult:
+    """Outcome of one pin or release.
+
+    Attributes:
+        group: Group the call addressed.
+        pinned: Keys this call pinned. For a release, keys it unpinned.
+        already: Keys the group already held, so no pin was taken again.
+        missing: Keys that were not resident and therefore not pinned.
+        bytes: Bytes the group holds after the call.
+        released_groups: Groups dropped while servicing the call, because they
+            were superseded, expired, or released to stay inside the budget.
+        rejected: Why the pin was refused, empty when it was accepted.
+    """
+
+    group: str
+    pinned: int = 0
+    already: int = 0
+    missing: int = 0
+    bytes: int = 0
+    released_groups: tuple[str, ...] = ()
+    rejected: str = ""
+
+
+class PinGroupRegistry:
+    """Hold L1 prefixes resident under a bounded budget.
+
+    The registry owns the group table and never touches cache identity, so a
+    group is invisible to lookups. It is thread safe: the store path pins from
+    the device host-function callback thread while HTTP handlers release.
+
+    Args:
+        l1_manager: The node's L1 manager, used to pin and unpin objects.
+        policy: ``off``, ``all``, or ``tagged``.
+        budget_bytes: Hard ceiling on pinned bytes. Zero disables the ceiling.
+        ttl_seconds: Idle time after which a group is released.
+        clock: Monotonic clock, injectable for tests.
+    """
+
+    def __init__(
+        self,
+        l1_manager: "L1Manager",
+        policy: str = "off",
+        budget_bytes: int = 0,
+        ttl_seconds: float = 600.0,
+        clock=None,
+    ) -> None:
+        if policy not in PIN_POLICIES:
+            raise ValueError(
+                f"unknown pin policy {policy!r}; expected one of {PIN_POLICIES}"
+            )
+        if budget_bytes < 0:
+            raise ValueError(f"budget_bytes must be >= 0, got {budget_bytes}")
+        if ttl_seconds <= 0:
+            raise ValueError(f"ttl_seconds must be > 0, got {ttl_seconds}")
+        self._l1_manager = l1_manager
+        self._policy = policy
+        self._budget_bytes = budget_bytes
+        self._ttl_seconds = ttl_seconds
+        self._clock = clock if clock is not None else time.monotonic
+        self._lock = threading.Lock()
+        self._groups: dict[str, PinGroup] = {}
+        self._pinned_total = 0
+        self._released_total = 0
+        self._rejected_total = 0
+
+    @property
+    def policy(self) -> str:
+        """The configured pin policy."""
+        return self._policy
+
+    @property
+    def enabled(self) -> bool:
+        """Whether the policy can pin anything at all."""
+        return self._policy != "off"
+
+    @property
+    def budget_bytes(self) -> int:
+        """The configured ceiling on pinned bytes, zero when unbounded."""
+        return self._budget_bytes
+
+    @property
+    def pinned_bytes(self) -> int:
+        """Bytes currently held resident by pin groups."""
+        with self._lock:
+            return sum(rec.bytes for rec in self._groups.values())
+
+    def pin(self, target: PinTarget, now: float | None = None) -> PinResult:
+        """Hold ``target``'s prefix resident, releasing what it supersedes.
+
+        Releases, in order: groups idle past the TTL, groups from an older
+        model version, groups this prefix supersedes, and finally groups
+        evicted to stay inside the byte budget. The last of those is the only
+        ordering that can refuse the call: when the new group alone would
+        exceed the budget it is released again and ``rejected`` is set, because
+        a ceiling that silently overshoots would let one long prefix starve L1.
+
+        Args:
+            target: The prefix to pin, already resolved to object keys.
+            now: Clock override for tests.
+
+        Returns:
+            PinResult: What was pinned, and what was released to do it.
+        """
+        timestamp = self._clock() if now is None else now
+        released: list[str] = []
+
+        with self._lock:
+            released.extend(self._sweep_locked(timestamp))
+            released.extend(self._release_older_versions_locked(target.version))
+            released.extend(self._release_superseded_locked(target))
+
+            rec = self._groups.get(target.group)
+            is_new = rec is None
+            if is_new:
+                rec = PinGroup(
+                    group=target.group,
+                    version=target.version,
+                    tail=target.tail,
+                    created_at=timestamp,
+                )
+
+            fresh = [key for key in target.keys if key not in rec.keys]
+            pinned_keys, pinned_bytes = self._l1_manager.pin_with_sizes(fresh)
+            rec.keys.update(pinned_keys)
+            rec.bytes += pinned_bytes
+            rec.last_touch = timestamp
+            self._groups[target.group] = rec
+            self._pinned_total += len(pinned_keys)
+
+            if self._budget_bytes and self._total_bytes_locked() > self._budget_bytes:
+                released.extend(self._enforce_budget_locked(exclude=target.group))
+                if (
+                    self._total_bytes_locked() > self._budget_bytes
+                    and is_new
+                    and rec.keys
+                ):
+                    # Only the new group can be responsible at this point.
+                    self._release_group_locked(rec)
+                    self._rejected_total += 1
+                    logger.warning(
+                        "Pin group %s needs %d bytes but the budget is %d; the "
+                        "prefix stays unpinned and falls back to LRU. Raise "
+                        "--l1-pin-budget-ratio until it covers one prefix.",
+                        target.group,
+                        rec.bytes,
+                        self._budget_bytes,
+                    )
+                    return PinResult(
+                        group=target.group,
+                        missing=len(fresh) - len(pinned_keys),
+                        released_groups=tuple(released),
+                        rejected="budget",
+                    )
+
+            return PinResult(
+                group=target.group,
+                pinned=len(pinned_keys),
+                already=len(target.keys) - len(fresh),
+                missing=len(fresh) - len(pinned_keys),
+                bytes=rec.bytes,
+                released_groups=tuple(released),
+            )
+
+    def release(self, group: str) -> PinResult:
+        """Release one group, releasing its keys exactly once.
+
+        Missing groups are not an error, because a restarted server and an
+        expired TTL both leave the caller holding an id the node no longer
+        knows. That idempotence is what lets a client release unconditionally.
+
+        Args:
+            group: Group id to release.
+
+        Returns:
+            PinResult: Keys unpinned, and the bytes the group held.
+        """
+        with self._lock:
+            rec = self._groups.get(group)
+            if rec is None:
+                return PinResult(group=group, released_groups=(group,))
+            unpinned = len(rec.keys)
+            held = rec.bytes
+            self._release_group_locked(rec)
+            return PinResult(
+                group=group,
+                pinned=unpinned,
+                bytes=held,
+                released_groups=(group,),
+            )
+
+    def release_all(self) -> int:
+        """Release every group, for example after a weight update.
+
+        Returns:
+            int: Number of groups released.
+        """
+        with self._lock:
+            groups = list(self._groups.values())
+            for rec in groups:
+                self._release_group_locked(rec)
+            return len(groups)
+
+    def sweep(self, now: float | None = None) -> int:
+        """Release groups that have been idle past the TTL.
+
+        Args:
+            now: Clock override for tests.
+
+        Returns:
+            int: Number of groups released.
+        """
+        timestamp = self._clock() if now is None else now
+        with self._lock:
+            return len(self._sweep_locked(timestamp))
+
+    def stats(self) -> dict[str, object]:
+        """Report the registry's state for operators.
+
+        Returns:
+            dict[str, object]: Policy, live groups, held bytes and keys, the
+            budget, and cumulative pin/release/reject counters.
+        """
+        with self._lock:
+            return {
+                "policy": self._policy,
+                "groups": len(self._groups),
+                "keys": sum(len(rec.keys) for rec in self._groups.values()),
+                "bytes": self._total_bytes_locked(),
+                "budget_bytes": self._budget_bytes,
+                "pinned_total": self._pinned_total,
+                "released_total": self._released_total,
+                "rejected_total": self._rejected_total,
+                "groups_detail": [
+                    {
+                        "group": rec.group,
+                        "version": rec.version,
+                        "keys": len(rec.keys),
+                        "bytes": rec.bytes,
+                    }
+                    for rec in sorted(self._groups.values(), key=lambda r: r.last_touch)
+                ],
+            }
+
+    def live_groups(self) -> list[str]:
+        """Return the ids of every live group, oldest first."""
+        with self._lock:
+            return [
+                rec.group
+                for rec in sorted(self._groups.values(), key=lambda r: r.last_touch)
+            ]
+
+    # --- internals, all called with ``self._lock`` held ---
+
+    def _total_bytes_locked(self) -> int:
+        return sum(rec.bytes for rec in self._groups.values())
+
+    def _release_group_locked(self, rec: PinGroup) -> None:
+        keys = list(rec.keys)
+        self._groups.pop(rec.group, None)
+        if keys:
+            self._l1_manager.unpin(keys)
+        self._released_total += 1
+
+    def _sweep_locked(self, now: float) -> list[str]:
+        expired = [
+            rec
+            for rec in self._groups.values()
+            if now - rec.last_touch > self._ttl_seconds
+        ]
+        for rec in expired:
+            self._release_group_locked(rec)
+            logger.debug(
+                "Pin group %s expired after %.0fs idle", rec.group, now - rec.last_touch
+            )
+        return [rec.group for rec in expired]
+
+    def _release_older_versions_locked(self, version: str) -> list[str]:
+        """Drop groups stored under an older model version.
+
+        Their objects are already unreachable, because the version tag takes
+        part in cache identity, so holding them only spends budget.
+        """
+        if not version.isdigit():
+            return []
+        newest = int(version)
+        stale = [
+            rec
+            for rec in self._groups.values()
+            if rec.version.isdigit() and int(rec.version) < newest
+        ]
+        for rec in stale:
+            self._release_group_locked(rec)
+        return [rec.group for rec in stale]
+
+    def _release_superseded_locked(self, target: PinTarget) -> list[str]:
+        """Drop the groups this prefix already covers.
+
+        A group is superseded when its tail chunk is itself a chunk of the new
+        prefix, which can only happen for an earlier turn of the same
+        conversation: chunk hashes chain over the whole prefix, so a matching
+        tail means a matching prefix.
+        """
+        superseded = [
+            rec
+            for rec in self._groups.values()
+            if rec.group != target.group and rec.tail in target.prefix_hashes
+        ]
+        for rec in superseded:
+            self._release_group_locked(rec)
+        return [rec.group for rec in superseded]
+
+    def _enforce_budget_locked(self, exclude: str) -> list[str]:
+        """Release the least recently pinned groups until the budget holds."""
+        released: list[str] = []

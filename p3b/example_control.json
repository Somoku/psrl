{
  "role": "control",
  "listen": "0.0.0.0:9000",
  "node_id": "control",
  "timing": { "node_ttl_s": 120, "rpc_timeout_s": 60 },
  "fleet": { "memory_mb": 1920000, "cpu_millis": 360000, "disk_mb": 8000000 },
  "classes": {
    "rollout": { "guaranteed_share": 0.45 },
    "grader": { "guaranteed_share": 0.45 }
  },
  "backends": [
    {
      "type": "docker",
      "mode": "direct",
      "socket": "/var/run/docker.sock",
      "api_version": "v1.40",
      "max_create_concurrency": 16
    }
  ],
  "fleet_nodes": [
    { "node_id": "node-a", "address": "127.0.0.1:9090" },
    { "node_id": "node-b", "address": "127.0.0.1:9091" }
  ],
  "default_backend": "docker"
}

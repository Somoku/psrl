diff --git a/verl/single_controller/ray/base.py b/verl/single_controller/ray/base.py
index 4bb9e5c..4078ab4 100644
--- a/verl/single_controller/ray/base.py
+++ b/verl/single_controller/ray/base.py
@@ -209,8 +209,51 @@ class RayClassWithInitArgs(ClassWithInitArgs):
             options = {"scheduling_strategy": NodeAffinitySchedulingStrategy(node_id=target_node_id, soft=False)}
             return self.cls.options(**options).remote(*self.args, cuda_visible_devices=cuda_visible_devices, **self.kwargs)
 
-        options = {"scheduling_strategy": PlacementGroupSchedulingStrategy(placement_group=placement_group, placement_group_bundle_index=placement_group_bundle_idx)}
+        options = {}
         options.update(self._options)
+        
+        if hasattr(self.cls, "configure_worker"):
+            config = self.kwargs.get("config", None)
+            # Specialized for PSRL
+            gen_interface = self.kwargs.get("gen_interface", None)
+            dp_idx = 0
+            if gen_interface is not None:
+                dp_idx = gen_interface.rollout_instance_id
+            # Get complete worker configuration from the worker class
+            # bundle_indices = range(len(placement_group.bundle_specs)) if placement_group_bundle_idx == 0 else None
+            bundle_indices = range(len(placement_group.bundle_specs))
+            resources, env_vars, init_kwargs = self.cls.configure_worker(
+                config=config,
+                num_gpus=num_gpus,
+                dp_idx=dp_idx,
+                bundle_indices=bundle_indices,
+            )
+            
+            # Apply resource configuration
+            if resources and "num_gpus" in resources:
+                num_gpus = resources["num_gpus"]
+            if resources and "num_cpus" in resources:
+                num_cpus = resources["num_cpus"]
+                options["num_cpus"] = num_cpus
+            
+            # Apply environment variables if provided
+            if env_vars:
+                if "runtime_env" not in options:
+                    options["runtime_env"] = {"env_vars": {}}
+                if "env_vars" not in options["runtime_env"]:
+                    options["runtime_env"]["env_vars"] = {}
+                for k, v in env_vars.items():
+                    options["runtime_env"]["env_vars"][k] = v
+
+            # Apply initialization parameters
+            if init_kwargs:
+                self.kwargs.update(init_kwargs)
+        
+        options["scheduling_strategy"] = PlacementGroupSchedulingStrategy(
+            placement_group=placement_group,
+            placement_group_bundle_index=placement_group_bundle_idx,
+            placement_group_capture_child_tasks=True,
+        )
 
         if use_gpu and device_name == "cuda":
             options["num_gpus"] = num_gpus

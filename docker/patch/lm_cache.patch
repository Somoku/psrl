+def is_pin_group_requested(policy: str, request_configs: dict | None) -> bool:
+    """Decide whether this request's prefix should be pinned.
+
+    Args:
+        policy: ``off``, ``all``, or ``tagged``.
+        request_configs: The request's LMCache request configs.
+
+    Returns:
+        bool: True when the policy wants this request pinned.
+    """
+    if policy == "off":
+        return False
+    if policy == "all":
+        return True
+    configs = request_configs or {}
+    return bool(configs.get(PIN_GROUP_CONFIG_KEY))

@@ -1218,3 +1220,21 @@ def clamp_prompt_logprobs(
             if logprob_values.logprob == float("-inf"):
                 logprob_values.logprob = -9999.0
     return prompt_logprobs
+
+def encode_routed_experts_payload(
+    routed_experts: np.ndarray | None,
+) -> RoutedExpertsPayload | None:
+    """Encode routed experts in compact transport form.
+
+    Returns shape + dtype + base64 payload. The data is normalized to
+    contiguous `int32` for stable wire compatibility.
+    """
+    if routed_experts is None:
+        return None
+
+    array = np.ascontiguousarray(routed_experts, dtype=np.int32)
+    return RoutedExpertsPayload(
+        shape=list(array.shape),
+        dtype=str(array.dtype),
+        data_base64=base64.b64encode(array.tobytes(order="C")).decode("ascii"),
+    )

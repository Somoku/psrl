+@runtime_checkable
+class SupportsWeightLayout(Protocol):
+    """Interface for vLLM models that expose unified weight layout specifications.
+
+    This is the new unified API for describing how vLLM parameters map to
+    HuggingFace parameters, including tensor transforms, model composition,
+    and auxiliary parameter synchronization.
+
+    The returned WeightLayoutPlan is consumed by PSRL to generate HF state dicts
+    and NIXL sharding without model-specific knowledge.
+
+    This protocol is designed to work with both:
+    - Models using AutoWeightsLoader (direct parameter mapping)
+    - Models with manual load_weights() (including custom stacked_params_mapping)
+    """
+
+    supports_weight_layout: ClassVar[bool] = True
+
+    def build_weight_layout(self) -> "WeightLayoutPlan":
+        """Build the unified weight layout plan for this model.
+
+        Returns:
+            WeightLayoutPlan describing:
+            - How vLLM parameters map to HF parameters
+            - Tensor transformations (reshape, split, concat, etc.)
+            - Sub-model composition (mounting)
+            - Parameter synchronization policy (MTP, Eagle, VL, etc.)
+
+        This plan must be:
+        - Reversible (enabling both vLLM -> HF and HF -> vLLM conversion)
+        - Comprehensive (covering all packed/fused/auxiliary parameters)
+        - Consistent (if model has load_weights(), use same mapping)
+        """
+        ...
+
+    @classmethod
+    def __subclasshook__(cls, C: type) -> bool:
+        if cls is SupportsWeightLayout:
+            return hasattr(C, "build_weight_layout")
+        return NotImplemented  # type: ignore[return-value]
+
+
 @runtime_checkable
 class SupportsLoRA(Protocol):

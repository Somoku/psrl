+    def pin_l1_keys(self, keys: list[ObjectKey]) -> tuple[int, int]:
+        """Pin the given keys in L1 so they survive eviction.
+
+        Pins are reference-counted and have no TTL; call :meth:`unpin_l1_keys`
+        exactly as many times as this succeeded for a key, or the object stays
+        resident for the lifetime of the server.
+
+        Args:
+            keys (list[ObjectKey]): List of object keys to pin.
+
+        Returns:
+            tuple[int, int]: ``(pinned, missing)`` -- the number of keys whose
+                pin count was incremented and the number refused because they
+                are not resident in L1.
+        """
+        results = self._l1_manager.pin(keys)
+        pinned = sum(1 for err in results.values() if err == L1Error.SUCCESS)
+        missing = sum(1 for err in results.values() if err == L1Error.KEY_NOT_EXIST)
+        return pinned, missing
+
+    def unpin_l1_keys(self, keys: list[ObjectKey]) -> tuple[int, int]:
+        """Release one pin per key, allowing eviction at zero.
+
+        Args:
+            keys (list[ObjectKey]): List of object keys to unpin.
+
+        Returns:
+            tuple[int, int]: ``(unpinned, refused)`` -- the number of keys whose
+                pin count was decremented and the number refused because they
+                are absent or were not pinned.
+        """
+        results = self._l1_manager.unpin(keys)
+        unpinned = sum(1 for err in results.values() if err == L1Error.SUCCESS)
+        refused = sum(
+            1
+            for err in results.values()
+            if err in (L1Error.KEY_NOT_EXIST, L1Error.KEY_IN_WRONG_STATE)
+        )
+        return unpinned, refused

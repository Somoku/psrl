+) -> tuple[bytes | None, frozenset[bytes]]:
+    """Return a chunk list's tail hash and its whole hash set.
+
+    Args:
+        object_keys: Object keys of one object group, in prefix order.
+
+    Returns:
+        tuple[bytes | None, frozenset[bytes]]: The last chunk's hash, and every
+        chunk hash present. The tail is ``None`` for an empty input.
+    """
+    hashes = [key.chunk_hash for key in object_keys]
+    if not hashes:
+        return None, frozenset()
+    return hashes[-1], frozenset(hashes)

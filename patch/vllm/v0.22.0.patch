-    # Create AsyncLLM
+    # Create a preemption queue for bridging scheduler stats to gRPC stream.
+    # This queue receives preempted request IDs from PreemptionStatLogger
+    # (which is registered as a stat logger) and feeds them to
+    # SubscribePreemptionEvents for client streaming.
+    preemption_queue: asyncio.Queue[list[str]] = asyncio.Queue()

+    """Pin a token sequence's chunks in this node's L1.
+
+    Pins are reference-counted and have no TTL, so a matching ``DELETE``
+    (or ``POST /cache/clear`` with ``force=true``) is required to release
+    them. Chunks that are not resident are reported as ``missing`` rather
+    than rejected.
+
+    Responses:
+        200: ``{"chunks", "pinned", "missing", "status"}``.
+        400: token cap exceeded or invalid key field. 503: not initialized.
+    """
+    return get_context(request).pin_service.pin(

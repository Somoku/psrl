diff --git a/lmcache/v1/multiprocess/pin_policy.py b/lmcache/v1/multiprocess/pin_policy.py
new file mode 100644
index 00000000..f7b8eb0e
--- /dev/null
+++ b/lmcache/v1/multiprocess/pin_policy.py
@@ -0,0 +1,89 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Decide whether a request's prefix should be pinned, and name the group.
+
+The policy lives here rather than in the L1 layer because it needs the request
+key and the token hasher, which only the multiprocess server has. The
+bookkeeping it feeds lives in
+:class:`lmcache.v1.distributed.pin_groups.PinGroupRegistry`.
+"""
+
+# Standard
+from dataclasses import replace
+from typing import Any, Callable
+
+# First Party
+from lmcache.logging import init_logger
+from lmcache.v1.distributed.api import ObjectKey
+from lmcache.v1.distributed.pin_groups import (
+    MODEL_VERSION_CONFIG_KEY,
+    PIN_GROUP_CONFIG_KEY,
+    PinTarget,
+    is_pin_group_requested,
+    iter_group_leaves,
+)
+from lmcache.v1.multiprocess.custom_types import IPCCacheServerKey
+
+logger = init_logger(__name__)
+
+# Resolves a key's token range into per-object-group object keys.
+ResolveKeys = Callable[[IPCCacheServerKey, list[int]], list[list[ObjectKey]]]
+
+
+def resolve_pin_target(
+    policy: str,
+    request_configs: dict[str, Any] | None,
+    key: IPCCacheServerKey,
+    object_group_ids: list[int],
+    resolve_keys: ResolveKeys,
+) -> PinTarget | None:
+    """Resolve the prefix to pin, or ``None`` when the policy does not apply.
+
+    The group is named ``<model_version>:<tail chunk hash>`` unless the request
+    carries an explicit ``lmcache.pin_group``, which overrides it. The hash
+    suffix is what lets a later turn recognise this group as its own ancestor
+    without either side knowing a trajectory id.
+
+    The whole prefix is resolved, not just the chunks this call wrote, because
+    a group must cover the full prefix it claims: the next turn releases this
+    group, and anything it left uncovered would become evictable.
+
+    Args:
+        policy: ``off``, ``all``, or ``tagged``.
+        request_configs: The request's LMCache request configs.
+        key: The IPC key of the store or prefetch being pinned.
+        object_group_ids: Object groups to resolve keys for.
+        resolve_keys: Resolver for a key's token range.
+
+    Returns:
+        PinTarget | None: The prefix to pin, or ``None`` if it is not wanted or
+        the sequence holds no complete chunk.
+
+    Raises:
+        ValueError: Propagated from the resolver for an invalid key.
+    """
+    if not is_pin_group_requested(policy, request_configs):
+        return None
+
+    # The prefix always starts at token zero: a group covers a conversation's
+    # whole cached prefix, not the range one operation happened to touch.
+    prefix_key = replace(key, start=0, end=len(key.token_ids))
+    resolved = resolve_keys(prefix_key, object_group_ids)
+    if not resolved or not resolved[0]:
+        return None
+
+    tail, prefix_hashes = iter_group_leaves(resolved[0])
+    if tail is None:
+        return None
+
+    configs = request_configs or {}
+    version = str(configs.get(MODEL_VERSION_CONFIG_KEY, ""))
+    explicit = configs.get(PIN_GROUP_CONFIG_KEY)
+    group = str(explicit) if explicit else f"{version}:{tail.hex()}"
+
+    return PinTarget(
+        group=group,
+        version=version,
+        tail=tail,
+        keys=tuple(obj_key for group_keys in resolved for obj_key in group_keys),
+        prefix_hashes=prefix_hashes,
+    )

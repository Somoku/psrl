+    )
+    # mis: q * (p/q) * 1[inside] == p inside the band, else 0
+    band = importance_sampling("token", "0.5_2.0")
+    inside = (log_ratio >= torch.tensor(0.5).log()) & (log_ratio <= torch.tensor(2.0).log())
+    torch.testing.assert_close(band.head_mass(p, q, log_ratio), torch.where(inside, p, torch.zeros_like(p)))
+    # tail_scale = rho * f(1 / rho)

+    def over_sample_dataset(self, over_sample_ratio: float = 1.0):
+        assert over_sample_ratio >= 1.0, "over_sample_ratio must be >= 1.0"
+
+        total = len(self.dataframe)
+        target_size = int(np.ceil(total * over_sample_ratio))
+
+        # if self.shuffle:
+        #     rng = np.random.default_rng(self.seed)
+        #     indices = rng.choice(total, size=target_size, replace=True)

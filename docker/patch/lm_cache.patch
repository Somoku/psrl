@@ -0,0 +1,144 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Node-local L1 pin / unpin operations.
+
+:class:`PinService` resolves a token sequence to its per-rank object keys and
+pins those objects in the node's L1 so they are excluded from eviction. Pins are
+reference-counted and have no TTL, so callers must unpin exactly as many times as
+they pinned. Unlike warm prefetch, pinning does not need a registered layout: a
+token sequence whose objects are not resident simply reports them as missing.
+
+It validates its own inputs and raises transport-agnostic domain errors (see
+:mod:`cache_control.errors`); the HTTP layer maps those to status codes.
+"""
+
+# Standard
+from typing import Any
+
+# First Party
+from lmcache.v1.multiprocess.cache_control.errors import InvalidRequest
+from lmcache.v1.multiprocess.cache_control.key_resolver import resolve_object_keys
+
+
+class PinService:
+    """Pin and unpin L1 objects on one node.
+
+    Args:
+        engine: The node's cache engine (resolves tokens and owns L1).
+    """
+
+    def __init__(self, engine: Any) -> None:
+        self._engine = engine
+
+    def pin(
+        self,
+        model_name: str,
+        world_size: int,
+        token_ids: list[int],
+        cache_salt: str,
+        request_configs: dict[str, Any] | None,
+    ) -> dict[str, object]:
+        """Pin the chunks of a token sequence in L1.
+
+        Args:
+            model_name: Model whose rank fan-out to use.
+            world_size: World size selecting the per-rank fan-out.
+            token_ids: Token sequence whose complete chunks should be pinned.
+            cache_salt: Per-tenant isolation salt.
+            request_configs: Request-scoped configs. ``lmcache.tag.*`` entries
+                participate in identity, so pass the configs the target
+                entries were stored under.
+
+        Returns:
+            ``{"chunks", "pinned", "missing", "status"}``. ``pinned`` counts
+            keys whose pin count was incremented; ``missing`` counts chunks not
+            resident in L1, which is not an error.
+
+        Raises:
+            InvalidRequest: token cap exceeded, or an invalid key field.
+        """
+        obj_keys, chunks = self._resolve(
+            model_name, world_size, token_ids, cache_salt, request_configs
+        )
+        if not chunks:
+            return {"chunks": 0, "pinned": 0, "missing": 0, "status": "noop"}
+        pinned, missing = self._engine.storage_manager.pin_l1_keys(obj_keys)
+        return {
+            "chunks": chunks,
+            "pinned": pinned,
+            "missing": missing,
+            "status": "pinned",
+        }
+
+    def unpin(
+        self,
+        model_name: str,
+        world_size: int,
+        token_ids: list[int],
+        cache_salt: str,
+        request_configs: dict[str, Any] | None,
+    ) -> dict[str, object]:
+        """Release one pin per chunk of a token sequence.
+
+        Args:
+            model_name: Model whose rank fan-out to use.
+            world_size: World size selecting the per-rank fan-out.
+            token_ids: Token sequence whose complete chunks should be unpinned.
+            cache_salt: Per-tenant isolation salt.
+            request_configs: Request-scoped configs, matching the pin call.
+
+        Returns:
+            ``{"chunks", "unpinned", "refused", "status"}``. ``refused`` counts
+            chunks that were absent or not pinned, which indicates an unpin
+            without a matching pin.
+
+        Raises:
+            InvalidRequest: token cap exceeded, or an invalid key field.
+        """
+        obj_keys, chunks = self._resolve(
+            model_name, world_size, token_ids, cache_salt, request_configs
+        )
+        if not chunks:
+            return {"chunks": 0, "unpinned": 0, "refused": 0, "status": "noop"}
+        unpinned, refused = self._engine.storage_manager.unpin_l1_keys(obj_keys)
+        return {
+            "chunks": chunks,
+            "unpinned": unpinned,
+            "refused": refused,
+            "status": "unpinned",
+        }
+
+    def _resolve(
+        self,
+        model_name: str,
+        world_size: int,
+        token_ids: list[int],
+        cache_salt: str,
+        request_configs: dict[str, Any] | None,
+    ) -> tuple[list[Any], int]:
+        """Resolve a token sequence to per-rank object keys.
+
+        Args:
+            model_name: Model whose rank fan-out to use.
+            world_size: World size selecting the per-rank fan-out.
+            token_ids: Token sequence to resolve.
+            cache_salt: Per-tenant isolation salt.
+            request_configs: Request-scoped configs.
+
+        Returns:
+            ``(obj_keys, chunk_count)``.
+
+        Raises:
+            InvalidRequest: token cap exceeded, or an invalid key field.
+        """
+        ctx = self._engine.context
+        try:
+            return resolve_object_keys(
+                ctx.token_hasher,
+                model_name,
+                world_size,
+                token_ids,
+                cache_salt,
+                request_configs,
+            )
+        except ValueError as exc:
+            raise InvalidRequest(str(exc)) from None

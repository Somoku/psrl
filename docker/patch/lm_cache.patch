diff --git a/tests/v1/distributed/test_pin_groups.py b/tests/v1/distributed/test_pin_groups.py
new file mode 100644
index 00000000..98df2e76
--- /dev/null
+++ b/tests/v1/distributed/test_pin_groups.py
@@ -0,0 +1,280 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Tests for prefix-derived pin groups.
+
+The registry is exercised against a fake L1 manager rather than a real slab, so
+the assertions can be about reference-count balance, which is the property that
+decides whether pinning leaks or wedges L1. The fake fails loudly on an
+unbalanced release instead of silently dropping the count to zero.
+"""
+
+# Standard
+import pytest
+
+# First Party
+from lmcache.v1.distributed.api import ObjectKey
+from lmcache.v1.distributed.pin_groups import (
+    PIN_GROUP_CONFIG_KEY,
+    PinGroupRegistry,
+    PinTarget,
+    is_pin_group_requested,
+    iter_group_leaves,
+)
+
+CHUNK = 8 * 1024
+
+
+def hashes(count: int) -> list[bytes]:
+    return [bytes([index + 1]) * 4 for index in range(count)]
+
+
+class FakeL1Manager:
+    """Minimal L1 manager whose reference counts must balance exactly."""
+
+    def __init__(self) -> None:
+        self.resident: set[ObjectKey] = set()
+        self.pins: dict[ObjectKey, int] = {}
+
+    def pin_with_sizes(self, keys: list[ObjectKey]) -> tuple[list[ObjectKey], int]:
+        pinned: list[ObjectKey] = []
+        total = 0
+        for key in keys:
+            if key not in self.resident:
+                continue
+            self.pins[key] = self.pins.get(key, 0) + 1
+            pinned.append(key)
+            total += CHUNK
+        return pinned, total
+
+    def unpin(self, keys: list[ObjectKey]) -> dict[ObjectKey, object]:
+        for key in keys:
+            if key not in self.pins:
+                # Mirrors L1Manager, which reports KEY_NOT_EXIST for a key that
+                # is already gone rather than failing the release.
+                continue
+            remaining = self.pins[key] - 1
+            assert remaining >= 0, f"unbalanced unpin for {key}"
+            self.pins[key] = remaining
+        return {}
+
+
+def key_for(chunk_hash: bytes, kv_rank: int = 0) -> ObjectKey:
+    return ObjectKey(chunk_hash=chunk_hash, model_name="model", kv_rank=kv_rank)
+
+
+def target(
+    group: str, chunk_hashes: list[bytes], ranks: int = 1, version: str = "1"
+) -> PinTarget:
+    return PinTarget(
+        group=group,
+        version=version,
+        tail=chunk_hashes[-1],
+        keys=tuple(
+            key_for(chunk_hash, rank)
+            for chunk_hash in chunk_hashes
+            for rank in range(ranks)
+        ),
+        prefix_hashes=frozenset(chunk_hashes),
+    )
+
+
+@pytest.fixture
+def l1() -> FakeL1Manager:
+    manager = FakeL1Manager()
+    all_hashes = hashes(8)
+    manager.resident = {key_for(chunk_hash) for chunk_hash in all_hashes}
+    return manager
+
+
+@pytest.fixture
+def registry(l1: FakeL1Manager) -> PinGroupRegistry:
+    return PinGroupRegistry(l1, policy="all", ttl_seconds=600.0)
+
+
+class TestPinGroupRegistry:
+    def test_pin_holds_every_resident_chunk(self, l1, registry):
+        chunk_hashes = hashes(3)
+        result = registry.pin(target("1:aa", chunk_hashes))
+        assert result.pinned == 3
+        assert result.bytes == 3 * CHUNK
+        assert registry.pinned_bytes == 3 * CHUNK
+        assert all(l1.pins[key_for(h)] == 1 for h in chunk_hashes)
+
+    def test_repinning_a_group_does_not_double_pin(self, l1, registry):
+        chunk_hashes = hashes(3)
+        registry.pin(target("1:aa", chunk_hashes))
+        result = registry.pin(target("1:aa", chunk_hashes))
+        assert result.pinned == 0
+        assert result.already == 3
+        assert all(l1.pins[key_for(h)] == 1 for h in chunk_hashes)
+
+    def test_missing_chunks_are_counted_not_pinned(self, l1, registry):
+        chunk_hashes = hashes(3)
+        l1.resident.discard(key_for(chunk_hashes[2]))
+        result = registry.pin(target("1:aa", chunk_hashes))
+        assert result.pinned == 2
+        assert result.missing == 1
+        assert key_for(chunk_hashes[2]) not in l1.pins
+
+    def test_a_longer_prefix_supersedes_its_ancestor(self, l1, registry):
+        """The next turn replaces the previous group without unpinning shared chunks."""
+        first = hashes(3)
+        registry.pin(target("1:aa", first))
+        longer = hashes(5)
+        result = registry.pin(target("1:bb", longer))
+
+        assert result.released_groups == ("1:aa",)
+        assert registry.live_groups() == ["1:bb"]
+        # Every chunk of the longer prefix is held exactly once: the ancestor's
+        # pin was released while the new group took its own.
+        assert all(l1.pins[key_for(h)] == 1 for h in longer)
+
+    def test_superseded_group_is_released_after_chunks_leave_l1(self, l1, registry):
+        """A chunk that is gone cannot be unpinned, and must not break the ledger."""
+        first = hashes(3)
+        registry.pin(target("1:aa", first))
+        l1.resident.discard(key_for(first[0]))
+        # Keep the pin map consistent with L1 losing the object outright.
+        l1.pins.pop(key_for(first[0]), None)
+
+        result = registry.pin(target("1:bb", hashes(5)))
+        assert "1:aa" in result.released_groups
+        assert registry.live_groups() == ["1:bb"]
+
+    def test_a_newer_version_releases_the_previous_one(self, l1, registry):
+        registry.pin(target("1:aa", hashes(3), version="1"))
+        result = registry.pin(target("2:bb", hashes(5), version="2"))
+        assert result.released_groups == ("1:aa",)
+        assert registry.live_groups() == ["2:bb"]
+
+    def test_release_is_idempotent(self, l1, registry):
+        chunk_hashes = hashes(3)
+        registry.pin(target("1:aa", chunk_hashes))
+        assert registry.release("1:aa").pinned == 3
+        assert all(l1.pins[key_for(h)] == 0 for h in chunk_hashes)
+        # Releasing again, or releasing something never seen, succeeds.
+        assert registry.release("1:aa").pinned == 0
+        assert registry.release("never-existed").released_groups == ("never-existed",)
+
+    def test_release_all_clears_every_group(self, l1, registry):
+        registry.pin(target("1:aa", hashes(2)))
+        registry.pin(target("1:bb", hashes(3)))
+        assert registry.release_all() == 2
+        assert registry.stats()["groups"] == 0
+        assert all(count == 0 for count in l1.pins.values())
+
+    def test_idle_groups_expire(self, l1):
+        now = {"value": 1000.0}
+        registry = PinGroupRegistry(
+            l1, policy="all", ttl_seconds=10.0, clock=lambda: now["value"]
+        )
+        registry.pin(target("1:aa", hashes(3)))
+        now["value"] += 5
+        assert registry.sweep() == 0
+        now["value"] += 11
+        assert registry.sweep() == 1
+        assert registry.live_groups() == []
+
+    def test_budget_releases_the_oldest_group_first(self, l1):
+        now = {"value": 1000.0}
+        registry = PinGroupRegistry(
+            l1, policy="all", budget_bytes=3 * CHUNK, clock=lambda: now["value"]
+        )
+        registry.pin(target("1:aa", hashes(2)))
+        now["value"] += 1
+        result = registry.pin(target("1:bb", hashes(3)))
+
+        assert result.released_groups == ("1:aa",)
+        assert registry.pinned_bytes <= 3 * CHUNK
+        assert registry.live_groups() == ["1:bb"]
+
+    def test_a_prefix_larger_than_the_budget_is_refused(self, l1):
+        """The cap is hard: one oversized prefix falls back to LRU, unpinned."""
+        registry = PinGroupRegistry(l1, policy="all", budget_bytes=2 * CHUNK)
+        result = registry.pin(target("1:aa", hashes(4)))
+
+        assert result.rejected == "budget"
+        assert result.pinned == 0
+        assert registry.pinned_bytes == 0
+        assert registry.live_groups() == []
+        assert registry.stats()["rejected_total"] == 1
+
+    def test_stats_report_the_live_set(self, l1, registry):
+        registry.pin(target("1:aa", hashes(3), ranks=2))
+        stats = registry.stats()
+        assert stats["policy"] == "all"
+        assert stats["groups"] == 1
+        assert stats["keys"] == 6
+        assert stats["bytes"] == 6 * CHUNK
+        assert stats["budget_bytes"] == 0
+        assert stats["groups_detail"][0]["group"] == "1:aa"
+
+    def test_ranks_are_pinned_independently(self, l1):
+        registry = PinGroupRegistry(l1, policy="all")
+        l1.resident = {key_for(hashes(2)[0], rank) for rank in range(2)}
+        result = registry.pin(target("1:aa", hashes(2)[:1], ranks=2))
+        assert result.pinned == 2
+        assert l1.pins[key_for(hashes(2)[0], 0)] == 1
+        assert l1.pins[key_for(hashes(2)[0], 1)] == 1
+
+    def test_config_rejects_unknown_policy_and_values(self, l1):
+        with pytest.raises(ValueError):
+            PinGroupRegistry(l1, policy="sometimes")
+        with pytest.raises(ValueError):
+            PinGroupRegistry(l1, policy="all", budget_bytes=-1)
+        with pytest.raises(ValueError):
+            PinGroupRegistry(l1, policy="all", ttl_seconds=0)

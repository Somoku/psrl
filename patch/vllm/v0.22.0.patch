@@ -154,6 +154,18 @@ class SchedulerConfig:
     while a larger value (e.g., 10) reduces host overhead and may increase throughput
     by batching multiple tokens before sending."""
 
+    preemption_notification_threshold: int | None = Field(default=None, ge=0)
+    """Number of waiting sequences above which a preempted request is forwarded
+    to an external gateway (via StatLoggers) for global re-scheduling rather than
+    being silently re-queued locally.
+
+    - ``None`` (default): feature disabled; zero runtime overhead.
+    - ``0``: notify whenever any request is waiting after a preemption.
+    - ``N``: notify when ``len(waiting) > N`` after a preemption.
+
+    This is a generic observability hook; it is not tied to any specific gateway.
+    """
+
     @staticmethod
     def default_factory(**kwargs):
         """

diff --git a/vllm/v1/worker/gpu_model_runner.py b/vllm/v1/worker/gpu_model_runner.py
index d51bf2284..c24f7b341 100644
--- a/vllm/v1/worker/gpu_model_runner.py
+++ b/vllm/v1/worker/gpu_model_runner.py
@@ -1369,6 +1369,26 @@ class GPUModelRunner(
                 # Replace the existing block IDs with the new ones.
                 req_state.block_ids = new_block_ids

+            # Resync block_ids to the scheduler's authoritative length. When a KV
+            # load failure rolls back num_computed_tokens without preemption (the
+            # scheduler's recompute policy keeps the request RUNNING, so the
+            # resumed_from_preemption replace path above is skipped), the scheduler
+            # frees the orphaned tail blocks but the runner only ever extends its
+            # own block_ids. Across repeated rollbacks the list drifts longer than
+            # the scheduler's req_to_blocks and can exceed the block_table row width
+            # (cdiv(max_model_len, block_size)), overflowing it on add_row. The
+            # surplus is always a dead tail (positions past max_model_len are never
+            # addressed), so clamp each group to its row capacity.
+            block_tables = self.input_batch.block_table.block_tables
+            if len(req_state.block_ids) == len(block_tables):
+                for g, group_block_ids in enumerate(req_state.block_ids):
+                    bt = block_tables[g]
+                    # block_ids are KV-manager blocks; the row width is in kernel
+                    # blocks, so convert back to the KV-block capacity.
+                    cap = bt.max_num_blocks_per_req // bt.blocks_per_kv_block
+                    if len(group_block_ids) > cap:
+                        del group_block_ids[cap:]
+
             if req_index is None:
                 # The request is not in the persistent batch.
                 # The request was either preempted and resumed later, or was not

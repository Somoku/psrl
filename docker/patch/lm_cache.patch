+class CacheEventStream:
+    """In-process fan-out of cache-event batches to streaming subscribers.
+
+    The observability bus's drain thread publishes from a worker thread while
+    FastAPI's SSE handlers consume from the event loop, so each subscriber gets
+    its own bounded queue and a slow consumer drops batches rather than blocking
+    the drain thread. Losing batches on a slow consumer is acceptable because a
+    router treats this stream as advisory cache state.
+
+    Drops are counted rather than only logged, so an operator can distinguish a
+    consumer that is briefly behind from one that is stalled and permanently
+    under-scoring the off-GPU tier. The count is cumulative for the process
+    lifetime, so it survives subscriber churn.
+
+    Args:
+        maxsize: Per-subscriber queue capacity.
+        drop_log_interval_s: Minimum seconds between overflow warnings.
+    """
+
+    def __init__(self, maxsize: int = 1024, drop_log_interval_s: float = 30.0) -> None:
+        self._lock = threading.Lock()
+        self._subscribers: set[queue.Queue] = set()
+        self._dropped_total = 0
+        self._maxsize = maxsize
+        self._drop_log_interval_s = drop_log_interval_s
+        self._last_drop_log_time = 0.0
+
+    def subscribe(self) -> "queue.Queue[bytes]":
+        """Register a subscriber.
+
+        Returns:
+            queue.Queue: The queue this subscriber drains. Pass it back to
+            :meth:`unsubscribe` when the stream ends.
+        """
+        subscriber: "queue.Queue[bytes]" = queue.Queue(maxsize=self._maxsize)
+        with self._lock:
+            self._subscribers.add(subscriber)
+        return subscriber
+
+    def unsubscribe(self, subscriber: "queue.Queue[bytes]") -> None:
+        """Deregister a subscriber.
+
+        Args:
+            subscriber: The queue returned by :meth:`subscribe`.
+        """
+        with self._lock:
+            self._subscribers.discard(subscriber)
+
+    def publish(self, payload: bytes) -> None:
+        """Offer one encoded payload to every subscriber, dropping on overflow.
+
+        Args:
+            payload: The encoded batch payload.
+        """
+        with self._lock:
+            subscribers = list(self._subscribers)
+        dropped = 0
+        for subscriber in subscribers:
+            try:
+                subscriber.put_nowait(payload)
+            except queue.Full:
+                dropped += 1
+        if dropped:
+            with self._lock:
+                self._dropped_total += dropped
+            self._log_drop(dropped)
+
+    def _log_drop(self, dropped: int) -> None:
+        """Warn about overflow at most once per ``drop_log_interval_s``.
+
+        Args:
+            dropped: Subscribers that overflowed on this payload.
+        """
+        now = time.monotonic()
+        if now - self._last_drop_log_time < self._drop_log_interval_s:
+            return
+        self._last_drop_log_time = now
+        logger.warning(
+            "Dropped a cache-event payload for %d slow stream subscriber(s); "
+            "dropped_total=%d. A router following this stream will under-score "
+            "the off-GPU tier until the next store or delete event arrives.",
+            dropped,
+            self.dropped_total,
+        )
+
+    @property
+    def dropped_total(self) -> int:
+        """Batches dropped across all subscribers since the stream started."""
+        with self._lock:
+            return self._dropped_total
+
+    def stats(self) -> dict[str, int]:
+        """Return stream health for operators and consumers.
+
+        Returns:
+            dict[str, int]: Subscriber count, per-subscriber capacity, and the
+            cumulative dropped-batch count.
+        """
+        with self._lock:
+            return {
+                "subscribers": len(self._subscribers),
+                "capacity": self._maxsize,
+                "dropped_total": self._dropped_total,
+            }
+
+
+class StreamCacheEventSink(CacheEventSink):
+    """Sink that fans batches out to in-process stream subscribers.
+
+    Serves an HTTP streaming route on the MP server, so routers can follow the
+    off-GPU cache state without taking a dependency on the coordinator.
+
+    Args:
+        stream: The hub to publish into.
+    """
+
+    def __init__(self, stream: CacheEventStream) -> None:
+        self._stream = stream
+
+    def publish(self, batches: list[CacheEventBatch]) -> None:
+        """Publish ``batches`` as one newline-delimited JSON payload.
+
+        Args:
+            batches: The batches to publish, in list order.
+        """
+        if not batches:
+            return
+        payload = CacheEventsRequest(batches=batches).model_dump_json()
+        self._stream.publish(payload.encode("utf-8") + b"\n")
+
+
+class FanoutCacheEventSink(CacheEventSink):
+    """Deliver each flushed batch list to several sinks, in order.
+
+    Both transports observe identical batches and sequence numbers because the
+    mapping and batching happen once. A failing sink aborts the fan-out, so a
+    partial delivery is reported exactly like any other publish failure and the
+    sequence gap is visible to the coordinator.
+
+    Args:
+        sinks: Sinks to deliver to, in delivery order.
+    """
+
+    def __init__(self, sinks: list[CacheEventSink]) -> None:
+        if not sinks:
+            raise ValueError("FanoutCacheEventSink requires at least one sink.")
+        self._sinks = sinks
+
+    def publish(self, batches: list[CacheEventBatch]) -> None:
+        """Deliver ``batches`` to each sink in turn.
+
+        Args:
+            batches: The batches to deliver.
+
+        Raises:
+            CacheEventPublishError: If any sink failed to deliver.
+        """
+        for sink in self._sinks:
+            sink.publish(batches)
+
+    def close(self) -> None:
+        """Close every sink."""
+        for sink in self._sinks:
+            sink.close()
+

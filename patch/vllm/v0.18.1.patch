diff --git a/vllm/model_executor/models/qwen2.py b/vllm/model_executor/models/qwen2.py
index 27aa6175b..19549d78e 100644
--- a/vllm/model_executor/models/qwen2.py
+++ b/vllm/model_executor/models/qwen2.py
@@ -189,6 +189,13 @@ class Qwen2Attention(nn.Module):
             if attn_type == AttentionType.ENCODER_ONLY
             else Attention
         )
+        
+        self.disable_attn = False
+        import os
+        if "VLLM_DISABLE_ATTN" in os.environ and os.environ["VLLM_DISABLE_ATTN"] == "1":
+            print("Hijacking the attention in Qwen2 to forbid the use of the attention.")
+            self.disable_attn = True
+        
         self.attn = attn_cls(
             self.num_heads,
             self.head_dim,
@@ -231,7 +238,11 @@ class Qwen2Attention(nn.Module):
             k = k.view(total_tokens, self.kv_size)
 
         q, k = self.rotary_emb(positions, q, k)
-        attn_output = self.attn(q, k, v)
+        # For profiling, we hijack here to forbid the use of the attention.
+        if self.disable_attn:
+            attn_output = q
+        else:
+            attn_output = self.attn(q, k, v)
         output, _ = self.o_proj(attn_output)
         return output
 
diff --git a/vllm/v1/engine/async_llm.py b/vllm/v1/engine/async_llm.py
index 7ff324f12..16f33c001 100644
--- a/vllm/v1/engine/async_llm.py
+++ b/vllm/v1/engine/async_llm.py
@@ -709,6 +709,15 @@ class AsyncLLM(EngineClient):
 
         self.output_handler = asyncio.create_task(output_handler())
 
+    async def abort_all(self) -> int:
+        """Abort all requests in OutputProcessor and EngineCore."""
+        all_request_ids = self.output_processor.abort_all()
+        await self.engine_core.abort_requests_async(all_request_ids)
+
+        if self.log_requests:
+            logger.info("Aborted all requests %s.", ",".join(all_request_ids))
+        return len(all_request_ids)
+
     async def abort(
         self, request_id: str | Iterable[str], internal: bool = False
     ) -> None:
diff --git a/vllm/v1/engine/output_processor.py b/vllm/v1/engine/output_processor.py
index f9e965092..5501c8fb0 100644
--- a/vllm/v1/engine/output_processor.py
+++ b/vllm/v1/engine/output_processor.py
@@ -443,6 +443,11 @@ class OutputProcessor:
             assert state.queue is not None
             state.queue.put(e)
 
+    def abort_all(self) -> list[str]:
+        # request_states.keys() are *internal* IDs (randomized by assign_request_id),
+        # so we must pass internal=True; using internal=False would look them up in
+        # external_req_ids where they don't exist, silently aborting nothing.
+        abort_request_ids = list(self.request_states.keys())
+        self.abort_requests(abort_request_ids, internal=True)
+        return abort_request_ids
+
     def abort_requests(self, request_ids: Iterable[str], internal: bool) -> list[str]:
         """Abort a list of requests.
 

{
  "role": "control",
  "listen": "0.0.0.0:9000",
  "node_id": "control",
  "timing": { "episode_deadline_s": 1800, "node_ttl_s": 120, "rpc_timeout_s": 60 },
  "fleet": { "memory_mb": 1920000, "cpu_millis": 360000, "disk_mb": 8000000 },
  "classes": {
    "rollout": { "guaranteed_share": 0.7 },
    "grader": { "guaranteed_share": 0.2 }
  },
  "backends": [
    { "type": "docker", "mode": "direct", "socket": "/var/run/docker.sock", "api_version": "v1.40" }
  ],
  "fleet_nodes": [
    { "node_id": "node-a", "address": "10.0.0.1:9090" },
    { "node_id": "node-b", "address": "10.0.0.2:9090" }
  ],
  "default_backend": "docker"
}

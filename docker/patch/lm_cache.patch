+    def test_iter_group_leaves_reports_tail_and_set(self):
+        chunk_hashes = hashes(3)
+        tail, present = iter_group_leaves([key_for(h) for h in chunk_hashes])
+        assert tail == chunk_hashes[-1]
+        assert present == frozenset(chunk_hashes)
+        assert iter_group_leaves([]) == (None, frozenset())

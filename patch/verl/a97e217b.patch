@@ -935,22 +935,31 @@ class DataProto:
         # Merge meta_info with special handling for metrics
         merged_meta_info = {}
         if data:
-            # Merge non-metric meta_info and aggregate metrics from all workers.
-            all_metrics = []
+            # Collect all keys from all workers
+            all_keys = set()
             for d in data:
-                for k, v in d.meta_info.items():
-                    if k == "metrics":
+                all_keys.update(d.meta_info.keys())
+            
+            all_metrics = []  # for key "metrics" only
+            for k in all_keys:
+                if k == "metrics":
+                    for d in data:
+                        v = d.meta_info.get(k)
                         if v is not None:
-                            if isinstance(v, list):
-                                all_metrics.extend(v)
-                            else:
-                                all_metrics.append(v)
-                    else:
-                        if k in merged_meta_info:
-                            # Ensure consistency for overlapping non-metric keys
-                            assert merged_meta_info[k] == v, f"Conflicting values for meta_info key '{k}'"
-                        else:
-                            merged_meta_info[k] = v
+                             if isinstance(v, list):
+                                 all_metrics.extend(v)
+                             else:
+                                 all_metrics.append(v)
+                elif k.endswith("_metrics"):
+                    # For xxx_metrics: merge as np.array([dict1, dict2, ...]) from each worker
+                    values = [d.meta_info.get(k) for d in data]
+                    merged_meta_info[k] = np.array(values)
+                else:
+                    # Ensure consistency for overlapping non-metric keys
+                    vals = [d.meta_info[k] for d in data if k in d.meta_info]
+                    if vals:
+                        assert all(vals[0] == v for v in vals), f"Conflicting values for meta_info key '{k}'"
+                        merged_meta_info[k] = vals[0]
 
             # Flatten list of dicts to dict of lists for consistent metrics structure
             if all_metrics:

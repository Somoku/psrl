@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Cache-event streaming endpoint on the MP server.
+
+Exposes the same cache-event batches the coordinator ingests, as newline
+delimited JSON, so an external consumer can follow the off-GPU tier without
+reading coordinator internals. Streams are advisory: a slow consumer drops
+batches rather than stalling the observability drain thread.
+
+Enable with ``--coordinator-event-stream-enable``. The stream is served from
+this node, so a consumer must be able to reach the server's HTTP port.
+"""
+
+# Standard
+import asyncio
+import queue
+
+# Third Party
+from fastapi import APIRouter, HTTPException, Request
+from fastapi.responses import StreamingResponse
+
+router = APIRouter()
+
+# Seconds without an event before the stream emits a keepalive newline.
+_KEEPALIVE_INTERVAL_S = 5.0
+
+
+@router.get("/cache/events/stream")
+async def stream_cache_events(request: Request) -> StreamingResponse:
+    """Stream cache events as newline delimited JSON.
+
+    Each line is one ``CacheEventsRequest`` payload, matching the coordinator's
+    ``POST /events`` body. Blank lines are keepalives and must be ignored.
+
+    Responses:
+        200: An open stream of JSON lines.
+        503: The stream is not enabled on this server.
+    """
+    stream = getattr(request.app.state, "event_stream", None)
+    if stream is None:
+        raise HTTPException(
+            status_code=503,
+            detail="cache event stream is not enabled on this server",
+        )
+    subscriber = stream.subscribe()
+
+    async def event_source():
+        """Yield queued payloads until the client disconnects."""
+        try:
+            while not await request.is_disconnected():
+                try:
+                    payload = await asyncio.to_thread(
+                        subscriber.get, True, _KEEPALIVE_INTERVAL_S
+                    )
+                except queue.Empty:
+                    yield b"\n"
+                    continue
+                yield payload
+        finally:
+            stream.unsubscribe(subscriber)
+
+    return StreamingResponse(event_source(), media_type="application/x-ndjson")
+
+
+@router.get("/cache/events/stats")
+async def cache_event_stream_stats(request: Request) -> dict:
+    """Report cache-event stream health.
+
+    The stream drops batches for a slow consumer instead of stalling the
+    observability drain thread, so a non-zero ``dropped_total`` means a
+    consumer fell behind and its view of the off-GPU tier is incomplete.
+
+    Responses:
+        200: Subscriber count, per-subscriber capacity, and dropped total.
+        503: The stream is not enabled on this server.
+    """
+    stream = getattr(request.app.state, "event_stream", None)
+    if stream is None:
+        raise HTTPException(
+            status_code=503,
+            detail="cache event stream is not enabled on this server",
+        )
+    return stream.stats()

+    p = torch.tensor([0.10, 0.40, 0.20, 0.05])
+    q = torch.tensor([0.20, 0.20, 0.20, 0.05])
+    log_ratio = (p / q).log()
+    # none: q * f(p/q) with f == 1
+    torch.testing.assert_close(importance_sampling(None, 2.0).head_mass(p, q, log_ratio), q)
+    # tis: q * min(p/q, c) == min(p, c*q)

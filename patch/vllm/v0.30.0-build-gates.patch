diff --git a/CMakeLists.txt b/CMakeLists.txt
index fbacfd9..8407369 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -456,9 +456,13 @@ if(VLLM_GPU_LANG STREQUAL "CUDA" OR VLLM_GPU_LANG STREQUAL "HIP")
     "csrc/libtorch_stable/fused_deepseek_v4_qnorm_rope_kv_insert_kernel.cu"
     "csrc/libtorch_stable/fused_kimi_k3_mla_key_concat_kv_cache_kernel.cu")
 
+  # 12.9, not 12.0: cooperative_topk.cuh calls the `cuda::ptx` mbarrier overloads
+  # that take a semantic tag (`sem_relaxed`), which CCCL only ships from CUDA 12.9.
+  # On 12.8 the looser gate compiles the kernel and fails with "no instance of
+  # overloaded function", so the gate is raised rather than the kernel patched.
   if(VLLM_GPU_LANG STREQUAL "CUDA" AND
      DEFINED CMAKE_CUDA_COMPILER_VERSION AND
-     CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 12.0)
+     CMAKE_CUDA_COMPILER_VERSION VERSION_GREATER_EQUAL 12.9)
 
     if(${CMAKE_CUDA_COMPILER_VERSION} VERSION_GREATER_EQUAL 13.0)
       cuda_archs_loose_intersection(COOPERATIVE_TOPK_ARCHS
diff --git a/setup.py b/setup.py
index 13692f3..e5b9bd2 100644
--- a/setup.py
+++ b/setup.py
@@ -1390,10 +1390,12 @@ if _is_cuda():
     ):
         ext_modules.append(CMakeExtension(name="vllm._flashkda_C", optional=True))
     if envs.VLLM_USE_PRECOMPILED or (
-        CUDA_HOME and get_nvcc_cuda_version() >= Version("12.3")
+        CUDA_HOME and get_nvcc_cuda_version() >= Version("12.9")
     ):
-        # DeepGEMM requires CUDA 12.3+ (SM90/SM100)
-        # Optional since it won't build on unsupported architectures
+        # DeepGEMM requires CUDA 12.9+: its own exception.cuh static_asserts on the
+        # driver and runtime API being 12.9, so the upstream 12.3 gate lets a 12.8
+        # toolchain start the build and then fail it. `optional=True` does not save it,
+        # because the failing target takes the whole ninja run down.
         ext_modules.append(CMakeExtension(name="vllm._deep_gemm_C", optional=True))
         ext_modules.append(CMakeExtension(name="vllm._qutlass_C", optional=True))
     # fmha_sm100 is a Python/CuTe-DSL package installed into vllm.third_party.

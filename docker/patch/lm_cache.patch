+# Tag encoding for L2 key serialization. Tags extend an ObjectKey's identity
+# with request-scoped values (for example ``lmcache.tag.model_version``) so
+# entries produced under different values never collide. All tags are written
+# into one trailing ``@``-separated field as ``<key>%<value>,<key>%<value>``;
+# keeping them in a single field is what makes the number of serialized fields
+# unambiguous when ``cache_salt`` is empty.
+_TAG_PAIR_SEP = ","
+_TAG_KV_SEP = "%"
+_TAG_FORBIDDEN_CHARS = frozenset("@/\\\x00,%")
+_TAG_MAX_LEN = 128
+
+
+def encode_tags(tags: "tuple[tuple[str, str], ...]") -> str:
+    """Serialize tag pairs into one L2-safe field.
+
+    Args:
+        tags: Sorted ``(key, value)`` pairs.
+
+    Returns:
+        str: ``<key>%<value>`` pairs joined by ``,``; empty when there are no
+        tags.
+    """
+    return _TAG_PAIR_SEP.join(f"{key}{_TAG_KV_SEP}{value}" for key, value in tags)
+
+
+def decode_tags(field: str) -> "tuple[tuple[str, str], ...]":
+    """Reverse :func:`encode_tags`.
+
+    Args:
+        field: The encoded tag field, or an empty string.
+
+    Returns:
+        tuple[tuple[str, str], ...]: The decoded pairs.
+
+    Raises:
+        ValueError: A pair is missing its ``%`` separator.
+    """
+    if not field:
+        return ()
+    tags = []
+    for pair in field.split(_TAG_PAIR_SEP):
+        key, sep, value = pair.partition(_TAG_KV_SEP)
+        if not sep:
+            raise ValueError(f"malformed tag pair (missing {_TAG_KV_SEP!r}): {pair!r}")
+        tags.append((key, value))
+    return tuple(tags)
+

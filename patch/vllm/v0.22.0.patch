diff --git a/vllm/v1/metrics/loggers.py b/vllm/v1/metrics/loggers.py
index 6855efd9f..8c81f52f8 100644
--- a/vllm/v1/metrics/loggers.py
+++ b/vllm/v1/metrics/loggers.py
@@ -1153,8 +1153,20 @@ class PrometheusStatLogger(AggregateStatLoggerBase):
         # Labeled prompt token counters by source
         pts = iteration_stats.prompt_token_stats
         for source in PromptTokenStats.ALL_SOURCES:
+            # PSRL: when externally loaded KV blocks fail to load, the scheduler's
+            # _handle_invalid_blocks decrements request.num_external_computed_tokens
+            # (see scheduler.py). That can leave num_external_computed_tokens larger
+            # than num_cached_tokens for the iteration, so the per-source delta
+            # computed in PromptTokenStats.update_from_output goes negative. A
+            # Prometheus Counter rejects a negative inc() with ValueError, which
+            # otherwise crashes the whole EngineCore. Clamp to 0 to keep the metric
+            # monotonic and the engine alive; correctness is unaffected because the
+            # affected tokens are recomputed regardless.
+            source_tokens = pts.get_by_source(source)
+            if source_tokens < 0:
+                source_tokens = 0
             self.counter_prompt_tokens_by_source[source][engine_idx].inc(
-                pts.get_by_source(source)
+                source_tokens
             )
         self.counter_prompt_tokens_cached[engine_idx].inc(pts.cached_tokens)
         self.counter_generation_tokens[engine_idx].inc(
@@ -1318,11 +1330,14 @@ class StatLoggerManager:
                     custom_prometheus_logger = True
